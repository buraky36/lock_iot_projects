ue;      \r\n   \ var dist =   Math.abs\(left - qLeft\) + Math.abs\(right - qRight\)                                   \r\n               + Math.abs\(top - qTop\) + Math.abs\(bottom - qBottom\);                                  \r\n    if \(\(lastDist >= 0\) && \(lastDist\ <= dist\)\) continue;                                             \r\n    lastDist = dist;                                                                                 \r\n    lastIndex = i;                                                             \                      \r\n}                                                                                                    \r\nif \(lastIndex >= 0\) this.selectPageNthWord\(pageIndex, lastIndex, bScroll=false\);                     })/S/JavaScript>>endobj10 0 obj<</Contents[13 0 R 14 0 R 15 0 R 16 0 R 17 0 R 18 0 R 19 0 R 20 0 R]/CropBox[0 0 842 595]/Group<</CS/DeviceRGB/S/Transparency>>/MediaBox[0 0 842 595]/Parent 1 0 R/Resources 11 0 R/Rotate 0/Type/Page>>endobj11 0 obj<</ExtGState<</GDIModeMask 21 0 R/GDIModeNormal 22 0 R>>/Font<</F8 12 0 R>>/ProcSet[/PDF/Text]/XObject<</IF0 26 0 R>>>>endobj12 0 obj<</BaseFont/Courier/Encoding/WinAnsiEncoding/FirstChar 32/LastChar 255/Subtype/Type1/Type/Font>>endobj13 0 obj<</Filter/FlateDecode/Length 881>>stream
